---
import { Font } from "astro:assets"

import ResumeDocument from "@/components/ResumeDocument.astro"
import { getCv, type Locale } from "@/cv"
import { localeStaticPaths, localized, localizedPath } from "@/lib/i18n"
import { LOCALE_TAGS } from "@/lib/ui"

export const getStaticPaths = localeStaticPaths

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const cv = await getCv()
const siteUrl = (Astro.site ?? new URL("https://imadelmalki.com")).toString()
const title = `${cv.basics.name} - ${localized(cv.resume.label, locale)}`
const description = localized(
  cv.basics.summaryPrint ?? cv.basics.summary,
  locale,
)
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="author" content={cv.basics.name} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/pdf"
      href={localizedPath(locale, "/cv.pdf")}
    />
    <Font cssVariable="--font-inter" />
  </head>
  <body>
    <ResumeDocument cv={cv} locale={locale} siteUrl={siteUrl} />
  </body>
</html>

<style is:global>
  @page {
    margin: 0;
    size: A4;
  }

  html {
    background: #edf1f3;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  body {
    margin: 0;
  }

  @media print {
    html,
    body {
      background: #fff;
    }
  }
</style>
