---
import Layout from "@/layouts/Layout.astro"
import ProjectDetail from "@/components/ProjectDetail.astro"
import ArrowRight from "@/icons/arrow-right.astro"
import { getCv, type Locale } from "@/cv"
import { PROJECT_DEMOS } from "@/data/projectDemos"
import { PROJECTS_COPY } from "@/data/projects"
import { CLOSING_SECTION_ID } from "@/lib/sections"
import { localized, localizedPath, t } from "@/lib/i18n"
import {
  projectPageHrefs,
  projectPagePath,
  publicPagePath,
} from "@/lib/publicPages"

interface Props {
  locale: Locale
  projectId: string
}

const { locale, projectId } = Astro.props
const cv = await getCv()
const project = cv.projects.find(({ id }) => id === projectId)

/* No es una guarda defensiva de las que sobran: `getStaticPaths` saca los `id`
   del mismo `cv.json`, así que si esto salta es que alguien cambió uno en un
   sitio y no en el otro, y conviene que el build lo diga en vez de emitir una
   página vacía. */
if (!project) throw new Error(`Unknown project id: ${projectId}`)

const visibleName = localized(project.name, locale)
const demo = PROJECT_DEMOS[project.id]

/**
 * El siguiente proyecto, en el orden de `cv.json` y cíclico.
 *
 * Cíclico y no «el último no tiene siguiente»: una ficha sin salida es la que
 * se quería evitar, y el orden del array es de autor, así que el último no es
 * peor que el primero. Con un solo proyecto se apunta a sí mismo, y entonces
 * no se pinta.
 */
const index = cv.projects.findIndex(({ id }) => id === project.id)
const next = cv.projects[(index + 1) % cv.projects.length]
const nextName =
  next && next.id !== project.id ? localized(next.name, locale) : null

const breadcrumb = [
  { label: t(locale, "home"), href: localizedPath(locale) },
  {
    label: t(locale, "projectsIndexLabel"),
    href: publicPagePath("projects", locale),
  },
]
---

<Layout
  cv={cv}
  locale={locale}
  localeHrefs={projectPageHrefs(project.id)}
  title={`${visibleName} · ${cv.basics.name}`}
  description={`${localized(PROJECTS_COPY.pageDescription, locale)} ${visibleName}.`}
  currentPage="projects"
  projectId={project.id}
>
  {
    /* A esta página se llega de fuera: por un enlace compartido o por un
      buscador, porque el índice abre la ficha en un diálogo. Hasta el
      07-10-2026 eso se resolvía con un solo «volver al portfolio» en la barra,
      y la ficha era un callejón con una salida. Ahora el camino está entero y
      por duplicado: arriba las migas —las mismas que el `BreadcrumbList` del
      JSON-LD ya declaraba sin que se vieran— y abajo el siguiente proyecto y
      las dos salidas del hero, que quien llega así no ha visto. */
  }
  <main id="main" class="project-page">
    <nav class="breadcrumb" aria-label={t(locale, "breadcrumb")}>
      <ol>
        {
          breadcrumb.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
        <li aria-current="page">{visibleName}</li>
      </ol>
    </nav>

    <ProjectDetail
      id={`project-${project.id}`}
      project={project}
      {...demo ? { demo } : {}}
      locale={locale}
      standalone
    />

    <footer class="project-footer">
      {
        nextName && next && (
          <a class="next-project" href={projectPagePath(next.id, locale)}>
            <span class="next-label">{t(locale, "nextProject")}</span>
            <span class="next-name">
              {nextName}
              <span class="next-arrow" aria-hidden="true">
                <ArrowRight />
              </span>
            </span>
          </a>
        )
      }

      <div class="project-cta">
        <p class="cta-heading">{t(locale, "projectCtaHeading")}</p>
        <div class="cta-actions">
          <a
            class="cta"
            href={localizedPath(locale, "/cv.pdf")}
            download
            data-hit="cv-pdf"
          >
            {t(locale, "heroDownloadCv")}
          </a>
          <a
            class="bracket-link"
            href={`${localizedPath(locale)}#${CLOSING_SECTION_ID}`}
          >
            <span class="bracket-link__bracket" aria-hidden="true"> [ </span>
            {t(locale, "heroWriteMe")}
            <span class="bracket-link__bracket" aria-hidden="true"> ] </span>
          </a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .project-page {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    inline-size: min(100% - 2rem, 46rem);
    margin-inline: auto;
    padding-block: 1.4rem 3rem;
  }

  /* Monoespaciada y pequeña: es orientación, no contenido, y compite con el
     `h1` que viene justo debajo. */
  .breadcrumb ol {
    align-items: center;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    gap: 0.4rem;
    letter-spacing: 0.04em;
    list-style: none;
    margin: 0;
    padding: 0;
    text-transform: uppercase;
  }

  /* El separador se dibuja con `content` de dos partes: la segunda, vacía, lo
     declara decorativo y evita que un lector de pantalla lea «barra» entre
     cada paso. Mismo truco que los separadores del hero. */
  .breadcrumb li + li::before {
    content: "/";
    content: "/" / "";
    margin-right: 0.4rem;
    opacity: 0.6;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover,
  .breadcrumb a:focus-visible {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .breadcrumb [aria-current="page"] {
    color: var(--text-subtle);
  }

  .project-footer {
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(1rem, 2vw, 1.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
  }

  .next-project {
    align-items: baseline;
    color: inherit;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    text-decoration: none;
  }

  .next-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .next-name {
    align-items: center;
    display: inline-flex;
    font-size: 1.05rem;
    font-weight: 600;
    gap: 0.4rem;
  }

  .next-arrow {
    display: inline-flex;
  }

  /* La flecha avanza al apuntar, que es la señal de que lleva a otro sitio y
     no abre nada aquí. Transición de un solo elemento: CSS, sin JS. */
  @media (prefers-reduced-motion: no-preference) {
    .next-arrow {
      transition: translate 200ms ease;
    }

    .next-project:hover .next-arrow,
    .next-project:focus-visible .next-arrow {
      translate: 0.2rem 0;
    }
  }

  .next-project:hover .next-name,
  .next-project:focus-visible .next-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .project-cta {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .cta-heading {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
  }

  .cta-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
</style>
