---
import Layout from "@/layouts/Layout.astro"
import ChevronLeft from "@/icons/chevron-left.astro"
import { getCv, type Locale, type Localized } from "@/cv"
import { PRIVACY_COPY } from "@/data/privacy"
import { localized, localizedPath, t } from "@/lib/i18n"
import { publicPageHrefs } from "@/lib/publicPages"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const cv = await getCv()
const say = (field: Localized) => localized(field, locale)
const copy = PRIVACY_COPY
---

<Layout
  cv={cv}
  locale={locale}
  localeHrefs={publicPageHrefs("privacy")}
  title={`${say(copy.pageTitle)} · ${cv.basics.name}`}
  description={say(copy.pageDescription)}
  currentPage="privacy"
>
  <main id="main" class="privacy-page">
    <header class="privacy-head">
      <a class="bracket-link back-link" href={localizedPath(locale)}>
        <span class="bracket-link__bracket" aria-hidden="true">[</span>
        <span class="bracket-link__icon" aria-hidden="true">
          <ChevronLeft />
        </span>
        <span>{t(locale, "backToPortfolio")}</span>
        <span class="bracket-link__bracket" aria-hidden="true">]</span>
      </a>
      <p class="eyebrow label-mono">{say(copy.eyebrow)}</p>
      <h1>{say(copy.pageTitle)}</h1>
      <p class="lead">{say(copy.intro)}</p>
      <p class="updated label-mono">{say(copy.updated)}</p>
    </header>

    <div class="privacy-sections">
      {
        copy.sections.map((section, index) => (
          <section aria-labelledby={`privacy-${index}`}>
            <p class="ordinal label-mono" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </p>
            <div>
              <h2 id={`privacy-${index}`}>{say(section.title)}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>
                  {say(paragraph)}
                  {index === copy.sections.length - 1 &&
                    paragraph === section.paragraphs.at(-1) && (
                      <>
                        {" "}
                        <a
                          href="https://www.aepd.es/"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          AEPD
                        </a>
                      </>
                    )}
                </p>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .privacy-page {
    margin: 0 auto;
    padding: clamp(2.25rem, 5vw, 4.75rem) clamp(1.25rem, 5vw, 3rem)
      clamp(4rem, 8vw, 7rem);
    width: min(100%, calc(var(--page-width) + 6rem));
  }

  .privacy-head,
  .privacy-sections {
    margin-inline: auto;
    width: min(100%, var(--page-width));
  }

  /* La caja la pone `.bracket-link` en `Layout.astro`, que es donde vive el
     control compartido por las tres landings y la portada. Aquí sólo queda el
     hueco que lo separa de lo que viene debajo. */
  .back-link {
    margin-bottom: 1.75rem;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 700;
    margin-top: 1.5rem;
  }

  h1 {
    color: var(--text);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin-top: 0.75rem;
  }

  .lead {
    color: var(--text-subtle);
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.65;
    margin-top: 1rem;
    max-width: 62ch;
  }

  .updated {
    color: var(--text-faint);
    margin-top: 1.5rem;
  }

  .privacy-sections {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  section {
    border-top: 1px solid var(--border);
    display: grid;
    gap: 0.75rem 1.25rem;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    padding-block: 1.5rem;
  }

  .ordinal {
    color: var(--accent);
    padding-top: 0.25rem;
  }

  h2 {
    color: var(--text);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    letter-spacing: -0.025em;
  }

  section p:not(.ordinal) {
    color: var(--text-subtle);
    line-height: 1.7;
    margin-top: 0.65rem;
    max-width: 75ch;
  }

  section a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (width <= 520px) {
    section {
      grid-template-columns: 1fr;
    }

    .ordinal {
      padding-top: 0;
    }
  }

  @media (hover: hover) {
    section a:hover {
      color: var(--accent);
    }
  }
</style>
