---
import type { CvData, Locale } from "@/cv"
import { getImage } from "astro:assets"
import profileImage from "@/assets/me.webp"
import {
  buildResumeSelection,
  formatResumeDateRange,
  formatResumePhone,
  RESUME_COPY,
} from "@/lib/resume"
import { localized } from "@/lib/ui"

interface Props {
  cv: Readonly<CvData>
  locale: Locale
  siteUrl: string
}

const { cv, locale, siteUrl } = Astro.props
const { basics, work, languages } = cv
const resume = buildResumeSelection(cv)
const copy = RESUME_COPY[locale]
const linkedIn = basics.profiles.find(({ network }) => network === "LinkedIn")
const github = basics.profiles.find(({ network }) => network === "GitHub")
const site = new URL(siteUrl)
const siteLabel = site.hostname.replace(/^www\./, "")
const country =
  new Intl.DisplayNames([locale], { type: "region" }).of(
    basics.location.countryCode,
  ) ?? basics.location.countryCode
const location = `${basics.location.city}, ${localized(basics.location.region, locale)}, ${country}`
const summary = basics.summaryPrint ?? basics.summary
const optimizedPortrait = await getImage({
  src: profileImage,
  width: 232,
  height: 232,
  format: "webp",
  quality: 80,
  fit: "cover",
  position: "center",
})
const cefrDots = { A1: 1, A2: 2, B1: 3, B2: 4, C1: 5, C2: 5 } as const
const languageDots = (level: CvData["languages"][number]["level"]) =>
  level === "native" ? 5 : cefrDots[level]
---

<main class="resume-document" data-resume-document>
  <header class="resume-header" data-resume-header>
    <div class="resume-identity">
      <h1>{basics.name}</h1>
      <p class="resume-role">{localized(cv.resume.label, locale)}</p>

      <address aria-label={copy.contact}>
        <ul class="contact-list">
          <li class="contact-item">
            <svg
              aria-hidden="true"
              class="contact-icon"
              focusable="false"
              viewBox="0 0 24 24"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m4 7 8 6 8-6"></path>
            </svg>
            <a href={`mailto:${basics.email}`}>{basics.email}</a>
          </li>
          {
            linkedIn && (
              <li class="contact-item">
                <svg
                  aria-hidden="true"
                  class="contact-icon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1" />
                  <path d="M14 11a5 5 0 0 0-7.1-.1l-2 2a5 5 0 0 0 7.1 7.1l1.1-1.1" />
                </svg>
                <a
                  href={linkedIn.url}
                >{`linkedin.com/in/${linkedIn.username}`}</a>
              </li>
            )
          }
          {
            basics.phone && (
              <li class="contact-item">
                <svg
                  aria-hidden="true"
                  class="contact-icon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path d="M6.6 3h3l1.5 4.5-2.2 1.3a15.5 15.5 0 0 0 6.3 6.3l1.3-2.2L21 14.4v3c0 2-1.6 3.6-3.6 3.6A14.4 14.4 0 0 1 3 6.6C3 4.6 4.6 3 6.6 3Z" />
                </svg>
                <a href={`tel:${basics.phone}`}>
                  {formatResumePhone(basics.phone)}
                </a>
              </li>
            )
          }
          {
            github && (
              <li class="contact-item">
                <svg
                  aria-hidden="true"
                  class="contact-icon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path d="m8 9-4 3 4 3" />
                  <path d="m16 9 4 3-4 3" />
                  <path d="m14 5-4 14" />
                </svg>
                <a href={github.url}>{`github.com/${github.username}`}</a>
              </li>
            )
          }
          <li class="contact-item">
            <svg
              aria-hidden="true"
              class="contact-icon"
              focusable="false"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"
              ></path>
            </svg>
            <a href={site.origin}>{siteLabel}</a>
          </li>
          <li class="contact-item">
            <svg
              aria-hidden="true"
              class="contact-icon"
              focusable="false"
              viewBox="0 0 24 24"
            >
              <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <span>{location}</span>
          </li>
        </ul>
      </address>
    </div>

    <img
      alt=""
      aria-hidden="true"
      class="resume-photo"
      data-resume-photo
      decoding="sync"
      height="1000"
      loading="eager"
      sizes="29mm"
      src={basics.image}
      srcset={`${optimizedPortrait.src} 232w`}
      width="800"
    />
  </header>

  <div class="resume-layout">
    <div class="resume-primary" data-resume-primary>
      <section data-resume-section="experience">
        <h2>{copy.sections.experience}</h2>
        {
          work.map((job) => {
            const roleSummary = job.summaryPrint ?? job.summary
            const highlights = job.highlightsPrint ?? job.highlights

            return (
              <article
                class="resume-entry work-entry"
                data-resume-work={job.name}
              >
                <h3>{localized(job.position, locale)}</h3>
                <p class="entry-company">
                  <strong>
                    <a href={job.url}>{job.name}</a>
                  </strong>
                  {job.description && (
                    <span>{` · ${localized(job.description, locale)}`}</span>
                  )}
                </p>
                <p class="entry-date">
                  {formatResumeDateRange(job.startDate, job.endDate, locale)}
                </p>
                <p>{localized(roleSummary, locale)}</p>
                <ul class="highlight-list">
                  {localized(highlights, locale).map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </article>
            )
          })
        }
      </section>

      <section data-resume-section="education">
        <h2>{copy.sections.education}</h2>
        {
          resume.education.map((item) => (
            <article
              class="resume-entry education-entry"
              data-resume-education={item.id}
            >
              <h3>
                {localized(item.studyType, locale)} {" · "}
                {localized(item.area, locale)}
              </h3>
              <p class="entry-company">
                <strong>{item.institution}</strong>
              </p>
              <p class="entry-date">
                {formatResumeDateRange(item.startDate, item.endDate, locale)}
              </p>
            </article>
          ))
        }
      </section>

      <section data-resume-section="projects">
        <h2>{copy.sections.projects}</h2>
        {
          resume.projects.map((project) => (
            <article
              class="resume-entry project-entry"
              data-resume-project={project.id}
            >
              <h3>{localized(project.name, locale)}</h3>
              <p class="project-stack">
                <strong>{copy.stack}:</strong> {project.technologies.join(", ")}
              </p>
              <ul class="highlight-list">
                {localized(project.highlights, locale)
                  .slice(0, 2)
                  .map((highlight) => (
                    <li>{highlight}</li>
                  ))}
              </ul>
            </article>
          ))
        }
      </section>
    </div>

    <aside class="resume-sidebar" data-resume-sidebar>
      <section data-resume-section="summary">
        <h2>{copy.sections.summary}</h2>
        <p>{localized(summary, locale)}</p>
      </section>

      <section data-resume-section="skills">
        <h2>{copy.sections.skills}</h2>
        <ul class="skill-groups">
          {
            resume.skillGroups.map(({ label, items }) => (
              <li class="skill-group">
                <h3>{localized(label, locale)}</h3>
                <ul class="skill-list">
                  {items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </section>

      <section data-resume-section="training">
        <h2>{copy.sections.training}</h2>
        <ul class="certification-list">
          {
            resume.certificates.map((certificate) => (
              <li data-resume-certificate={certificate.id}>
                {certificate.url ? (
                  <a href={certificate.url}>
                    <strong>{localized(certificate.name, locale)}</strong>
                  </a>
                ) : (
                  <strong>{localized(certificate.name, locale)}</strong>
                )}
                <span class="certificate-meta">
                  {certificate.issuer}
                  {` · ${certificate.date.slice(0, 4)}`}
                  {certificate.hours ? ` · ${certificate.hours} h` : ""}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section data-resume-section="languages">
        <h2>{copy.sections.languages}</h2>
        <ul class="language-list">
          {
            languages.map((language) => {
              const filledDots = languageDots(language.level)

              return (
                <li data-resume-language={language.language.en}>
                  <span class="language-copy">
                    <strong>{localized(language.language, locale)}</strong>
                    <span>{localized(language.fluency, locale)}</span>
                    {language.level !== "native" && (
                      <span>{language.level}</span>
                    )}
                  </span>
                  <span class="language-dots" aria-hidden="true">
                    {Array.from({ length: 5 }, (_, index) => (
                      <span
                        class:list={[
                          "language-dot",
                          { "language-dot-filled": index < filledDots },
                        ]}
                      />
                    ))}
                  </span>
                </li>
              )
            })
          }
        </ul>
      </section>
    </aside>
  </div>
</main>

<style>
  .resume-document {
    --accent: #0b63ce;
    --divider: #cfd4da;
    --ink: #141619;
    --muted: #4b5057;
    background: #fff;
    box-sizing: border-box;
    color: var(--ink);
    font-family: var(--font-inter), Arial, sans-serif;
    font-size: 9pt;
    height: 297mm;
    line-height: 1.22;
    margin: 0 auto;
    padding: 11mm;
    width: 210mm;
  }

  .resume-header {
    align-items: center;
    display: grid;
    gap: 7mm;
    grid-template-columns: minmax(0, 1fr) 29mm;
    padding-bottom: 5mm;
  }

  .resume-identity {
    min-width: 0;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin-top: 0;
  }

  h1 {
    color: #050607;
    font-size: 22pt;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1;
    margin-bottom: 1.2mm;
    text-transform: uppercase;
  }

  .resume-role {
    color: var(--accent);
    font-size: 10.5pt;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 2.5mm;
  }

  address {
    font-style: normal;
  }

  .contact-list,
  .skill-groups,
  .skill-list,
  .certification-list,
  .language-list {
    list-style: none;
    padding-left: 0;
  }

  .contact-list {
    display: grid;
    gap: 1.1mm 4mm;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    margin-bottom: 0;
  }

  .contact-item {
    align-items: center;
    display: flex;
    gap: 1.2mm;
    min-height: 6.35mm;
    min-width: 0;
  }

  .contact-item a,
  .contact-item span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-icon {
    fill: none;
    flex: 0 0 3mm;
    height: 3mm;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    width: 3mm;
  }

  .resume-photo {
    aspect-ratio: 1;
    border: 1.2mm solid #0d1117;
    border-radius: 50%;
    box-sizing: border-box;
    display: block;
    height: 29mm;
    object-fit: cover;
    object-position: center 31%;
    width: 29mm;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .contact-item a,
  .entry-company a,
  .certification-list a {
    color: var(--accent);
  }

  .resume-layout {
    align-items: start;
    display: grid;
    gap: 7mm;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  }

  .resume-primary,
  .resume-sidebar {
    min-width: 0;
  }

  section {
    break-inside: avoid;
  }

  section + section {
    margin-top: 3.6mm;
  }

  h2 {
    border-bottom: 0.7mm solid #111;
    color: #111;
    font-size: 10.25pt;
    font-weight: 750;
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin-bottom: 1.6mm;
    padding-bottom: 0.7mm;
    text-transform: uppercase;
  }

  h3 {
    color: #111;
    font-size: 9.25pt;
    font-weight: 750;
    line-height: 1.18;
    margin-bottom: 0.45mm;
  }

  p {
    margin-bottom: 1mm;
  }

  .resume-entry {
    break-inside: avoid;
    margin-bottom: 1.9mm;
    padding-bottom: 1.9mm;
  }

  .resume-entry:not(:last-child) {
    border-bottom: 0.3mm dashed var(--divider);
  }

  .resume-entry:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .entry-company {
    margin-bottom: 0.3mm;
  }

  .entry-date,
  .certificate-meta {
    color: var(--muted);
  }

  .entry-date {
    margin-bottom: 0.8mm;
  }

  .highlight-list {
    margin-bottom: 0;
    padding-left: 4.4mm;
  }

  .highlight-list li {
    margin-bottom: 0.35mm;
    padding-left: 0.3mm;
  }

  .highlight-list li::marker {
    color: var(--accent);
  }

  .project-stack {
    color: var(--muted);
    margin-bottom: 0.7mm;
  }

  .project-stack strong {
    color: var(--ink);
  }

  .resume-sidebar section + section {
    margin-top: 4.1mm;
  }

  .skill-groups {
    margin-bottom: 0;
  }

  .skill-group + .skill-group {
    margin-top: 1.6mm;
  }

  .skill-group h3 {
    color: var(--accent);
    margin-bottom: 0.9mm;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2mm 2.1mm;
    margin-bottom: 0;
  }

  .skill-list li {
    border-bottom: 0.3mm solid #aeb4bc;
    font-weight: 650;
    padding: 0 1.4mm 0.5mm;
  }

  .certification-list {
    margin-bottom: 0;
  }

  .certification-list li {
    break-inside: avoid;
    border-bottom: 0.3mm dashed var(--divider);
    margin-bottom: 1.5mm;
    padding-bottom: 1.5mm;
  }

  .certification-list li:last-child {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .certification-list strong,
  .certificate-meta {
    display: block;
  }

  .certification-list strong {
    line-height: 1.17;
    margin-bottom: 0.35mm;
  }

  .language-list {
    margin-bottom: 0;
  }

  .language-list > li {
    align-items: center;
    border-bottom: 0.3mm dashed var(--divider);
    display: flex;
    gap: 2mm;
    justify-content: space-between;
    padding: 1mm 0;
  }

  .language-list > li:first-child {
    padding-top: 0;
  }

  .language-list > li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .language-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .language-copy > span {
    color: var(--muted);
  }

  .language-dots {
    display: flex;
    flex: 0 0 auto;
    gap: 0.8mm;
  }

  .language-dot {
    background: #d7dce2;
    border-radius: 50%;
    display: block;
    height: 3.1mm;
    width: 3.1mm;
  }

  .language-dot-filled {
    background: var(--accent);
  }

  @media screen {
    .resume-document {
      box-shadow: 0 8px 30px rgb(20 34 44 / 0.12);
      margin-block: 20px;
    }
  }

  @media screen and (max-width: 760px) {
    .resume-document {
      height: auto;
      margin-block: 0;
      min-height: 0;
      padding: 24px 20px;
      width: 100%;
    }

    .resume-header,
    .resume-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .resume-header {
      gap: 20px;
    }

    .resume-photo {
      height: 104px;
      justify-self: start;
      width: 104px;
    }

    .contact-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .resume-layout {
      gap: 28px;
    }
  }

  @media print {
    .resume-document {
      box-shadow: none;
      margin: 0;
    }
  }
</style>
