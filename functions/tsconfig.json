{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    "**/*.ts",
    "../src/lib/apiResponse.ts",
    "../src/lib/contact.ts",
    "../src/lib/ask.ts",
    "../src/data/about.ts",
    "../src/data/askNotes.ts",
    "../src/data/availability.ts",
    "../src/data/services.ts"
  ],
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "noEmit": true,
    "resolveJsonModule": true,
    /* `about.ts` y `services.ts` traen `import type { Localized } from "@/cv"`.
       Es una importación de tipos, así que esbuild la borra al empaquetar el
       Worker y en tiempo de ejecución no existe — pero `tsc` sí tiene que
       resolverla para comprobar el archivo. El alias replica el de la raíz.

       Los dos módulos de datos siguen siendo del sitio, no del Worker: aquí
       sólo se leen. `ask.ts`, en cambio, es de los dos, y por eso no tiene ni
       una importación propia (ver su cabecera). */
    "paths": {
      "@/*": ["../src/*"]
    }
  }
}
